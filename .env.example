# Copy to .env and adjust before first start.

# Login credentials for the first start (used only while the users table is empty).
GBV_USERNAME=admin
# Leave empty to have a random password generated and printed once in `docker compose logs`.
GBV_PASSWORD=

# Set true when the app is reachable via HTTPS (directly or behind a reverse proxy).
GBV_COOKIE_SECURE=false

# Session lifetime in days.
GBV_SESSION_TTL_DAYS=30
